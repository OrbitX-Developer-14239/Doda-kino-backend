# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
SERVER_URL=https://dodakino.orbitx.uz

# ── Bazalar (MULTIBOT) ────────────────────────────────────────────────────────
# MAIN — barcha botlar uchun umumiy: admins, bots registri, server_logs
MONGO_URI_MAIN=mongodb+srv://<user>:<parol>@<host>/

# Har bot IKKI clusterga ega:
#   MONGO_URIn   (content): films, episodes
#   MONGO_URIn.1 (data):    users, channels, discoveredchats
# Yangi bot qo'shish = BOTn_TOKEN + ikkita URI + CHANNEL_IDn qo'shish, tamom.
MONGO_URI1=mongodb+srv://<user>:<parol>@<host>/
MONGO_URI1.1=mongodb+srv://<user>:<parol>@<host>/
MONGO_URI_BOT2=
MONGO_URI_BOT2.1=
MONGO_URI_BOT3=
MONGO_URI_BOT3.1=

# ── Bot tokenlari ─────────────────────────────────────────────────────────────
# Tokenlar FAQAT shu yerda turadi — bot endi tokenini backendga yubormaydi.
# Bot ID avtomatik aniqlanadi (token boshidagi raqam).
BOT1_TOKEN=
BOT2_TOKEN=
BOT3_TOKEN=

# Har botning media (poster/video) kanali — bot o'sha kanalda admin bo'lsin
CHANNEL_ID1=
CHANNEL_ID2=
CHANNEL_ID3=

# ── Autentifikatsiya ──────────────────────────────────────────────────────────
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ikkalasi ham majburiy, bir xil bo'lmasligi va kamida 32 belgi bo'lishi kerak.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=15d

# Birinchi ishga tushishda yaratiladigan superadmin.
# PAROL BERILMASA tasodifiy parol generatsiya qilinadi va konsolga bir marta chiqadi.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# ── CORS / Panel ──────────────────────────────────────────────────────────────
ADMIN_PANEL_URL=https://panel.example.uz
# Vergul bilan ajratilgan ro'yxat. Production da bo'sh bo'lmasligi kerak.
CORS_ORIGINS=https://panel.example.uz

# Ishlab chiqish davrida: istalgan localhost portidan ruxsat beradi
# (panel dasturchining noutbukida turganda kerak). Panel tayyor bo'lgach false qiling.
CORS_ALLOW_LOCALHOST=false

# Swagger ni ochish uchun (production da faqat ataylab yoqiladi).
# Production da yoqilsa SWAGGER_PASSWORD majburiy — /api-docs Basic auth bilan yopiladi.
ENABLE_SWAGGER=false
SWAGGER_USER=docs
SWAGGER_PASSWORD=

# ── Telegram ──────────────────────────────────────────────────────────────────
CHANNEL_ID=-100...

# ── Instagram / Meta ──────────────────────────────────────────────────────────
INSTAGRAM_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TEMP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
